#!/usr/bin/env bash
# =============================================================================
#  update
#
#  Refreshes a Debian/Ubuntu Nowhere machine in one word. With bootstrap.sh it
#  is the only thing that installs or upgrades anything.
#
#    1. apt packages (apt-get update + upgrade, via sudo unless root)
#    2. pins (bootstrap/lib/pins.sh, the same module bootstrap uses): release
#       binaries, uv tools (the login banner on a server) and zsh plugins moved to
#       their pins, installed if missing; never floats past a pin
#    3. uv self update (skipped when uv is not on PATH)
#
#  The role comes from NOWHERE_ROLE (set by the stub); unset means server.
#  A failing step is reported and the rest still run; exit status is non-zero
#  if any step failed.
# =============================================================================
set -uo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
ROLE=server
[ "${NOWHERE_ROLE:-}" = devbox ] && ROLE=devbox
FAILED=0

step() { echo "==> $*"; }
warn() { echo "update: $*" >&2; FAILED=1; }

SUDO=""
[ "$(id -u)" -eq 0 ] || SUDO=sudo

# --- 1. apt -------------------------------------------------------------------
update_apt() {
    if ! command -v apt-get > /dev/null 2>&1; then
        echo "apt-get not found, skipping system packages"
        return 0
    fi
    step "apt packages"
    if ! { $SUDO apt-get update && $SUDO apt-get upgrade -y; }; then
        warn "apt step failed"
    fi
}

# --- 2. pins --------------------------------------------------------------------
update_pins() {
    step "pinned tools and plugins ($ROLE)"
    bash "$REPO_ROOT/bootstrap/lib/pins.sh" "$ROLE" || warn "some pins could not be brought into place"
}

# --- 3. uv --------------------------------------------------------------------------
update_uv() {
    if ! command -v uv > /dev/null 2>&1; then
        echo "uv not found, skipping (run bootstrap)"
        return 0
    fi
    step "uv self update"
    uv self update || warn "uv self update failed"
}

update_apt
update_pins
update_uv

if [ "$FAILED" -eq 0 ]; then step "update complete"; else echo "update: finished with errors" >&2; fi
exit "$FAILED"
