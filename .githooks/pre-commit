#!/bin/sh
# Block commits that stage secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found; install it (winget install gitleaks.gitleaks | brew install gitleaks)" >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
